APP_NAME=daalgi-knowledge-api
DATABASE_URL=sqlite:///./runtime/daalgi.db
STORAGE_ROOT=./runtime/storage
PPTX_PDF_CONVERTER=
ALLOW_APPROXIMATE_PDF_FALLBACK=false
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
OPENAI_API_KEY=
LLM_MODEL=gpt-5.6-luna
MAX_UPLOAD_BYTES=524288000
DEFAULT_GRAPH_HOPS=2
# Configure one or more existing document folders. Use ':' on Linux/macOS and ';' on Windows.
LOCAL_DOCUMENT_ROOTS=../data_raw
LOCAL_SCAN_LIMIT=10000
ENABLE_REGISTRATION=true
ENABLE_TEST_ACCOUNT=true
AUTH_SESSION_HOURS=24
# Set these only for the first deployment to create one administrator account.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=관리자
# Comma-separated browser origins. Keep '*' for a token-header-only MVP.
CORS_ORIGINS=*
